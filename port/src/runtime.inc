; runtime.inc - execution model for SAB2.COM code translated to x86-64.
; Included by src/game.asm (hand-written parts), src/data.asm and
; build/sab2_code.asm (generated by tools/asm2nasm.py).
;
; Registers
;   - 8086 registers keep their 16/8-bit names (AX, BX, CL, SI, ...).
;     Invariant: the upper 48 bits of rax, rbx, rcx, rdx, rsi, rdi, rbp are
;     always zero. 16-bit PUSH/POP become 64-bit pushes of the full register.
;   - r12 = DS base, r13 = ES base (host pointers). The 16-bit segment values
;     live in seg_ds / seg_es; SET_SEG maps a value to its base.
;   - r14 is scratch for effective addresses and helpers. r15 is scratch for
;     helpers. Neither carries 8086 state.
;   - Register-based addresses are computed as lea r14d,[regs+disp] followed by
;     movzx r14d,r14w: exact 16-bit wraparound, no flags touched.
;   - AH/BH/CH/DH cannot be encoded with a REX prefix, which every [r12/r13/r14]
;     operand needs; VIA_LOW swaps the high byte into the low byte around the
;     instruction (xchg leaves the flags untouched).
;   - Every helper here preserves the flags unless the 8086 instruction it
;     replaces sets them.
;   - 16-bit PUSH/POP use the host stack (8 bytes per slot). The one place the
;     game saves and reloads SP (sound_seq_play) saves and reloads rsp.
;   - CS is the constant CS_VALUE; the code is reached through labels L_xxxx,
;     and computed jumps (JMP BX) through cs_labels.

default rel

%ifidn __OUTPUT_FORMAT__, elf64
section .note.GNU-stack noalloc noexec nowrite progbits   ; non-executable stack
section .text
%endif

; C calling convention: first integer argument register, and the shadow space
; a Windows x64 caller reserves above the return address for the callee.
%ifidn __OUTPUT_FORMAT__, win64
%define ARG1  rcx
%define ARG1D ecx
%define SHADOW_SPACE 32
%else
%define ARG1  rdi
%define ARG1D edi
%define SHADOW_SPACE 0
%endif

; C_STACK: 16-byte align rsp (and reserve the shadow space) for a C call.
%macro C_STACK 0
    and rsp, -16
%if SHADOW_SPACE
    sub rsp, SHADOW_SPACE
%endif
%endmacro

; Windows x64 also preserves rsi and rdi across calls; entry points called
; from C save them around the translated code.
%macro PUSH_WIN64_NONVOL 0
%ifidn __OUTPUT_FORMAT__, win64
    push rsi
    push rdi
%endif
%endmacro

%macro POP_WIN64_NONVOL 0
%ifidn __OUTPUT_FORMAT__, win64
    pop rdi
    pop rsi
%endif
%endmacro

%define CS_VALUE 0x1000              ; the code segment (PSP) value
%define CS_LABELS_COUNT 0x2E61       ; cs_labels entries: CS:0000..2E60
%define VERSION_TEXT 0x7A30          ; DS offset of the menu version string (data.asm)

%ifndef RUNTIME_DEFINES_STATE
extern seg_ds
extern seg_es
extern ccall_ret
extern seg_to_base
extern game_exit
extern timer_poll_wait
extern timer_poll_run
%endif
%ifndef RUNTIME_DEFINES_CS_LABELS
extern cs_labels
%endif
extern dos_exit
extern cpu
%ifndef RUNTIME_DEFINES_DS
extern ds_base
%endif
extern cga_vram
extern game_trap

%define CPU_AX   0
%define CPU_BX   2
%define CPU_CX   4
%define CPU_DX   6
%define CPU_SI   8
%define CPU_DI  10
%define CPU_BP  12
%define CPU_PORT 14

%define SEGBASE_ds r12
%define SEGBASE_es r13

; ---------------------------------------------------------------------------
; Segments

; SET_SEG ds|es, reg16  (MOV DS,AX / MOV ES,AX)
%macro SET_SEG 2
    mov [seg_%1], %2
    movzx r14d, %2
    call seg_to_base
    mov SEGBASE_%1, r14
%endmacro

; GET_SEG reg16, ds|es  (MOV AX,DS)
%macro GET_SEG 2
    mov %1, [seg_%2]
%endmacro

%macro PUSH_SEG 1
    movzx r14d, word [seg_%1]
    push r14
%endmacro

%macro POP_SEG 1
    pop r14
    mov [seg_%1], r14w
    call seg_to_base
    mov SEGBASE_%1, r14
%endmacro

; ---------------------------------------------------------------------------
; Instruction helpers

; VIA_LOW high, low, {instruction written with the low byte register}
%macro VIA_LOW 3
    xchg %1, %2
    %3
    xchg %1, %2
%endmacro

; STRINGOP {[rep|repne|repe] movsb|movsw|stosb|stosw|lodsb|lodsw|scasb|cmpsb...}
; DS:SI / ES:DI with 16-bit offsets; DF and the flags the instruction sets
; behave as on the 8086.
%macro STRINGOP 1
    movzx esi, si
    movzx edi, di
    movzx ecx, cx
    lea rsi, [rsi + r12]
    lea rdi, [rdi + r13]
    %1
    pushfq
    sub rsi, r12
    sub rdi, r13
    movzx esi, si
    movzx edi, di
    popfq
%endmacro

; LOOP / LOOPZ / LOOPNZ on CX, flag-free like the originals.
%macro LOOP16 1
    lea ecx, [rcx - 1]
    movzx ecx, cx
    jrcxz %%done
    jmp %1
%%done:
%endmacro

%macro LOOPZ16 1
    lea ecx, [rcx - 1]
    movzx ecx, cx
    jrcxz %%done
    jz %1
%%done:
%endmacro

%macro LOOPNZ16 1
    lea ecx, [rcx - 1]
    movzx ecx, cx
    jrcxz %%done
    jnz %1
%%done:
%endmacro

; LAHF / SAHF via the flags image (not relying on 64-bit LAHF support).
%macro LAHF16 0
    pushfq
    pop r14
    xchg al, ah
    mov al, r14b
    xchg al, ah
%endmacro

%macro SAHF16 0
    pushfq
    pop r14
    xchg al, ah
    mov r14b, al
    xchg al, ah
    push r14
    popfq
%endmacro

; AAA as on the 8086: if (AL & 0Fh) > 9 or AF: AL += 6, AH += 1, AF = CF = 1,
; else AF = CF = 0; then AL &= 0Fh. Other flags keep their previous values.
%macro AAA16 0
    pushfq
    pop r14
    test r14d, 0x10
    jnz %%adjust
    mov r15d, eax
    and r15d, 0x0f
    cmp r15d, 9
    ja %%adjust
    and r14, ~0x11
    jmp %%done
%%adjust:
    add al, 6
    inc ah
    or r14, 0x11
%%done:
    and al, 0x0f
    push r14
    popfq
%endmacro

; ---------------------------------------------------------------------------
; Calls into C

; CCALL fn: keep 8086 registers and flags, DF=0 and a 16-byte aligned stack
; for the C ABI; the C return value (eax) is left in [ccall_ret].
%macro CCALL 1
    pushfq
    push rax
    push rcx
    push rdx
    push rsi
    push rdi
    push rbp
    mov rbp, rsp
    C_STACK
    cld
    call %1
    mov [ccall_ret], eax
    mov rsp, rbp
    pop rbp
    pop rdi
    pop rsi
    pop rdx
    pop rcx
    pop rax
    popfq
%endmacro

%macro SAVE_CPU 0
    mov [cpu + CPU_AX], ax
    mov [cpu + CPU_BX], bx
    mov [cpu + CPU_CX], cx
    mov [cpu + CPU_DX], dx
    mov [cpu + CPU_SI], si
    mov [cpu + CPU_DI], di
    mov [cpu + CPU_BP], bp
%endmacro

%macro LOAD_CPU 0
    mov ax, [cpu + CPU_AX]
    mov bx, [cpu + CPU_BX]
    mov cx, [cpu + CPU_CX]
    mov dx, [cpu + CPU_DX]
    mov si, [cpu + CPU_SI]
    mov di, [cpu + CPU_DI]
    mov bp, [cpu + CPU_BP]
%endmacro

; BIOS bios_intNN: INT NNh, registers in and out through the cpu struct.
%macro BIOS 1
    SAVE_CPU
    CCALL %1
    LOAD_CPU
%endmacro

; IN AL,imm / IN AL,DX / OUT imm,AL / OUT DX,AL
%macro PORT_IN 1
    mov word [cpu + CPU_PORT], %1
    CCALL io_in
    mov al, [ccall_ret]
%endmacro

%macro PORT_IN_DX 0
    mov [cpu + CPU_PORT], dx
    CCALL io_in
    mov al, [ccall_ret]
%endmacro

%macro PORT_OUT 1
    mov word [cpu + CPU_PORT], %1
    mov [cpu + CPU_AX], ax
    CCALL io_out
%endmacro

%macro PORT_OUT_DX 0
    mov [cpu + CPU_PORT], dx
    mov [cpu + CPU_AX], ax
    CCALL io_out
%endmacro

; BIOS_ZF bios_intNN: as BIOS, then ZF = 1 if the C handler returned 1
; (INT 16h/01h: no key waiting). The other flags are kept.
%macro BIOS_ZF 1
    BIOS %1
    pushfq
    pop r14
    and r14, ~0x40
    mov r15d, [ccall_ret]
    and r15d, 1
    shl r15d, 6
    or r14, r15
    push r14
    popfq
%endmacro

; DOS bios_int21: INT 21h; after AH=4Ch the game leaves through game_exit.
%macro DOS 1
    BIOS %1
    pushfq
    cmp byte [dos_exit], 0
    jne game_exit
    popfq
%endmacro

extern bios_int10
extern bios_int16
extern bios_int1a
extern bios_int21
extern io_in
extern io_out
extern cpu_pace
extern game_bad_jump

; CPU_PACE ns: account ns of original 8088 time before the next instruction
; (see cpu_pace in bios.c). Registers and flags are preserved.
%macro CPU_PACE 1
    push ARG1
    mov ARG1D, %1
    CCALL cpu_pace
    pop ARG1
%endmacro

; XLAT: AL = DS:[BX + AL], 16-bit wraparound, flags untouched.
%macro XLAT16 0
    movzx r14d, al
    lea r14d, [r14 + rbx]
    movzx r14d, r14w
    mov al, [r12 + r14]
%endmacro

; JCXZ target: flag-free, any distance (jrcxz alone reaches +-127 bytes; the
; upper bits of rcx are zero, so it tests CX).
%macro JCXZ16 1
    jrcxz %%take
    jmp %%done
%%take:
    jmp %1
%%done:
%endmacro

; JMP_CS reg16: JMP reg (the 8086 jumps to CS:reg). Looks the label up in
; cs_labels; flags are passed through to the target.
%macro JMP_CS 1
    pushfq
    movzx r14d, %1
    cmp r14d, CS_LABELS_COUNT
    jae %%bad
    lea r15, [cs_labels]
    movsxd r14, dword [r15 + r14*4]
    test r14, r14
    jz %%bad
    add r14, r15
    popfq
    jmp r14
%%bad:
    movzx ARG1D, %1
    C_STACK
    call game_bad_jump
%endmacro

; TIMER_POLL timer_poll_wait|timer_poll_run: run the installed INT 1Ch handler
; once per timer tick that is due (game.asm). _wait first sleeps until the
; next tick if none is due. Registers and flags are preserved.
%macro TIMER_POLL 1
    call %1
%endmacro

; TRAP cs: an instruction the translator could not handle was reached.
%macro TRAP 1
    mov ARG1D, %1
    C_STACK
    call game_trap
%endmacro
